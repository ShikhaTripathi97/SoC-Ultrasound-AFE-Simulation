[DISPLAYS]
BEGIN DISPLAY LAST SESSION
ANALYSIS TRANSIENT_ANALYSIS
SYMBOL ALWAYS
TRACECOLORSCHEME NORMAL
BEGIN ANAPLOT 1
ACTIVE
XBASE
BEGIN XAXIS
XAXISUSERNAME 0 (null)
TEXT Time
RANGEFLAG AUTO
TYPE LINEAR
UNIT s
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
END XAXIS
BEGIN YAXIS 1
YAXISSIDE LEFT
ACTIVE
RANGEFLAG AUTO
TYPE LINEAR
UNIT V
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
BEGIN TRACE V(C7:2)
MARKERID 1
TRACEADDEXT
END TRACE V(C7:2)
BEGIN TRACE V(U2:VOH)
MARKERID 2
TRACEADDEXT
END TRACE V(U2:VOH)
BEGIN TRACE V(U2:VOL)
MARKERID 3
TRACEADDEXT
END TRACE V(U2:VOL)
BEGIN TRACE V(U1:LOP)
MARKERID 4
TRACEADDEXT
END TRACE V(U1:LOP)
END YAXIS 1
END ANAPLOT 1
END DISPLAY LAST SESSION
